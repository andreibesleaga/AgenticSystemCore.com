# Generated by hand for the pre-release site; superseded by the engine's emitter at site v0.
# Cross-origin read access (D67, blocker 1): every artefact here is public, static and
# credential-free, so the wildcard is both sufficient and safe. Without it no browser
# agent can read this node at all.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'none'; style-src 'unsafe-inline'; img-src 'self' data:; base-uri 'none'; form-action 'none'
  Permissions-Policy: interest-cohort=()

/.well-known/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=300

/llms.txt
  Content-Type: text/plain; charset=utf-8
  Access-Control-Allow-Origin: *

/graph.ttl
  Content-Type: text/turtle; charset=utf-8
  Access-Control-Allow-Origin: *

/graph.jsonld
  Content-Type: application/ld+json; charset=utf-8
  Access-Control-Allow-Origin: *

/graph.nq
  Content-Type: application/n-quads; charset=utf-8
  Access-Control-Allow-Origin: *

/ledger.jsonl
  Content-Type: text/plain; charset=utf-8
  Access-Control-Allow-Origin: *
