box build 16 100 100 60 "build"
region routes 160 20 284 236 "the route set"
box r1 174 36 256 30 "pages: items, clusters, tags, search, NOW"
box r2 174 74 256 30 "graph, search.json, chunks, llms.txt"
box r3 174 112 256 30 "/.well-known/knowledge-linkset" acc
box r4 174 150 256 30 "headers, sitemap, robots, security.txt"
box r5 174 188 256 30 "ledger, boards, skills, /ns/"
arrow build r1 via=142,51
arrow build r2 via=142,89
arrow build r3
arrow build r4 via=142,165
